{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}/firmware",
    "env": {
      // The Makefile falls back to plain `xc8-cc` if this is empty, but tasks
      // do not source ~/.bashrc, so point at the compiler explicitly.
      "XC8DIR": "/opt/microchip/xc8/v2.46/bin"
    }
  },
  "problemMatcher": {
    "owner": "c",
    "fileLocation": ["relative", "${workspaceFolder}/firmware"],
    "pattern": {
      "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error|fatal error):\\s+(.*)$",
      "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
    }
  },
  "tasks": [
    {
      "label": "Build firmware",
      "type": "shell",
      "command": "make",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": {
        "owner": "c",
        "fileLocation": ["relative", "${workspaceFolder}/firmware"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error|fatal error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": []
    },
    {
      "label": "Open in SimulIDE",
      "type": "shell",
      "command": "${env:HOME}/.local/bin/simulide blackbox.sim1",
      "isBackground": true,
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Build & Simulate",
      "dependsOrder": "sequence",
      "dependsOn": ["Build firmware", "Open in SimulIDE"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
